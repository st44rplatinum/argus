# Data never enters the repo — licences vary and volumes are large.
data/*
# The feature index is the exception: 388 KB, and the 23.58 GB archive it was
# computed from has been deleted, so it is no longer cheap to rebuild.
!data/derived/
data/derived/*
!data/derived/organ_features.npz
!data/derived/contrast_phase.json
*.dcm
*.nii
*.nii.gz
*.nrrd

# Model weights and derived indices are rebuildable artefacts.
weights/
*.onnx
*.pth
*.ckpt
*.idx

.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

node_modules/
dist/
build/

orthanc-db/

.env
.DS_Store

# OHIF checkout — a build dependency, not our code. Our extension and mode
# live in viewer/extensions and viewer/modes.
viewer/Viewers/

# Generated pnpm shim — see scripts/dev_viewer.py
.tooling/

.pytest_cache/

jobs.sqlite3

# Dataset downloads and their logs
data/raw/*.zip
data/raw/download.log
